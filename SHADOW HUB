local autoEatEnabled = false
local function GetConsumeRemote()
    local success, remote = pcall(function()
        return ReplicatedStorage:WaitForChild("Systems", 3)
            :WaitForChild("ActionsSystem", 3)
            :WaitForChild("Network", 3)
            :WaitForChild("Consume", 3)
    end)
    return success and remote or nil
end

local ConsumeRemote = GetConsumeRemote()

task.spawn(function()
    local slotIndex = 1
    while true do
        task.wait(0.1)
        if autoEatEnabled and ConsumeRemote and LocalPlayer.Character then
            for i = 1, 6 do
                local currentSlot = slotIndex
                task.defer(function()
                    pcall(function()
                        ConsumeRemote:InvokeServer(currentSlot)
                    end)
                end)
                slotIndex = slotIndex + 1
                if slotIndex > 36 then
                    slotIndex = 1
                end
            end
        end
    end
end)

