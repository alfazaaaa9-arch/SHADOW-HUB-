        if moveLeft then moveDir = moveDir - camera.CFrame.RightVector end
        if moveRight then moveDir = moveDir + camera.CFrame.RightVector end
        
        local currentSpeed = tonumber(ZFlySpeedBox.Text) or 100
        
        if zFlyBodyVelocity and zFlyBodyGyro then
            zFlyBodyVelocity.Velocity = moveDir * currentSpeed
            zFlyBodyGyro.CFrame = camera.CFrame
        end
    end
end)
