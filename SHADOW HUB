        zFlyBodyGyro.CFrame = hrp.CFrame
        zFlyBodyGyro.Parent = hrp
        
        if humanoid then humanoid.PlatformStand = true end
    else
        ZFlyToggleBtn.Text = "Z-FLY: OFF"
        ZFlyToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        
        if zFlyBodyVelocity then zFlyBodyVelocity:Destroy() end
        if zFlyBodyGyro then zFlyBodyGyro:Destroy() end
        
        local char = LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid.PlatformStand = false end
        end
    end
    notifyToggle("Z-Fly", zFlyFlying)
end

