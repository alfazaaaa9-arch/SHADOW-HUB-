local killAuraEnabled = false
local lagMachineEnabled = false
local godModeEnabled = false

local function nullifyRemote(networkFolder, remoteName)
    local realRemote = networkFolder:FindFirstChild(remoteName)
    if realRemote then
        local dummy = Instance.new("RemoteEvent")
        dummy.Name = remoteName
        dummy.Parent = networkFolder
        realRemote:Destroy()
    end
end

RunService.Heartbeat:Connect(function()
    if godModeEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local hum = char.Humanoid
            if hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end
    end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local function findCombatRemote()
        local possiblePaths = {
            ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("ActionsSystem") and ReplicatedStorage.Systems.ActionsSystem.Network:FindFirstChild("Attack"),
            ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Combat") and ReplicatedStorage.Systems.Combat:FindFirstChild("Attack"),
            ReplicatedStorage:FindFirstChild("Combat") and ReplicatedStorage.Combat:FindFirstChild("Attack"),
            ReplicatedStorage:FindFirstChild("Attack")
        }
        for _, remote in ipairs(possiblePaths) do
            if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
                return remote
            end
        end
        return nil
    end

    local CombatRemote = findCombatRemote()

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= LocalPlayer and targetPlayer.Character then
            local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = targetPlayer.Character:FindFirstChild("Humanoid")
            
            if targetHrp and targetHum and targetHum.Health > 0 then
                local dist = (targetHrp.Position - hrp.Position).Magnitude
                if dist <= 75 then
                    if killAuraEnabled and CombatRemote then
                        pcall(function()
                            if CombatRemote:IsA("RemoteEvent") then
                                CombatRemote:FireServer(targetPlayer.Character, 1)
                            else
                                CombatRemote:InvokeServer(targetPlayer.Character, 1)
                            end
                        end)
                    end

                    if lagMachineEnabled and CombatRemote then
                        pcall(function()
                            for i = 1, 15 do
                                if CombatRemote:IsA("RemoteEvent") then
                                    CombatRemote:FireServer(targetPlayer.Character, 999999)
                                else
                                    CombatRemote:InvokeServer(targetPlayer.Character, 999999)
                                end
                            end
                        end)
                    end
                end
            end
        end
    end
end)

