-- HIGH-PERFORMANCE 100 HPS ULTRA KILL AURA
-- ============================================================================
local kaMaxTargets = 12
local ATTACKS_PER_BURST = 5
local kaActive = false
local kaConnection = nil
local kaRange = 85
local BASE_DAMAGE = math.huge

local function isValidTarget(c)
    return c and c:FindFirstChild("Humanoid") and c:FindFirstChild("HumanoidRootPart") and c.Humanoid.Health > 0
end

local function getKATargets()
    local my = player.Character
    if not isValidTarget(my) then return {} end
    local pos = my.HumanoidRootPart.Position
    local candidates = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if isValidTarget(char) then
                local dist = (char.HumanoidRootPart.Position - pos).Magnitude
                if dist <= kaRange then table.insert(candidates, {char = char, dist = dist}) end
            end
        end
    end
    table.sort(candidates, function(a,b) return a.dist < b.dist end)
    local result = {}
    for i = 1, math.min(#candidates, kaMaxTargets) do
        table.insert(result, candidates[i].char)
    end
    return result
end

local function attackAll()
    if not kaActive or not kaRemote then return end
    local targets = getKATargets()
    if #targets == 0 then return end
    
    task.spawn(function()
        for _, target in ipairs(targets) do
            if not kaActive then break end
            pcall(function()
                for _ = 1, ATTACKS_PER_BURST do
                    if kaRemote:IsA("RemoteFunction") then
                        kaRemote:InvokeServer(target, "1", BASE_DAMAGE)
                    else
                        kaRemote:FireServer(target, "1", BASE_DAMAGE)
                    end
                end
            end)
        end
    end)
end

local function startKillAura()
    if kaActive then return end
    kaActive = true
    moduleStates["KILL AURA"] = true
    if not kaConnection then
        kaConnection = RunService.Heartbeat:Connect(attackAll)
        addCleanup(kaConnection)
    end
end

local function stopKillAura()
    kaActive = false
    moduleStates["KILL AURA"] = false
    if kaConnection then
        kaConnection:Disconnect()
        kaConnection = nil
    end
end

