local fallenEnabled = false
local fallenSlotIndex = 1
local fallenConnection = nil
local fallenTimer = 0
local fallenEatCount = 0
local FALLEN_EAT_RATE = 50

local function fallenEatOne()
    if not Consume then return end
    local slot = SLOTS[fallenSlotIndex]
    pcall(function()
        if Consume:IsA("RemoteFunction") then Consume:InvokeServer(slot) else Consume:FireServer(slot) end
    end)
    fallenSlotIndex = fallenSlotIndex + 1
    if fallenSlotIndex > #SLOTS then fallenSlotIndex = 1 end
end

local function fallenProcess(deltaTime)
    if not fallenEnabled or not Consume then return end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return end

    fallenTimer = fallenTimer + deltaTime
    local target = FALLEN_EAT_RATE * fallenTimer
    while fallenEatCount < target do
        fallenEatOne()
        fallenEatCount = fallenEatCount + 1
    end
    if fallenTimer >= 1 then
        fallenTimer = 0
        fallenEatCount = 0
    end
end

